# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / Angular — handled in web/.gitignore too, repeated here so the
# patterns hold no matter which directory git is invoked from.
node_modules/
web/dist/
web/.angular/
web/coverage/
npm-debug.log*

# Secrets — never commit these
.env
.env.*
!.env.example
back/vimeo-cookies.txt
*cookies*.txt
*.env.local

# Downloaded media. Task state is in memory and the app rebuilds this
# directory on demand, so nothing here belongs in version control.
back/downloads/
*.mp4
*.webm
*.mkv
*.mov
*.part